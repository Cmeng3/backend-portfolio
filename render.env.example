# Import into Render's Environment page, then replace every placeholder.
APP_NAME="Chimeng Ly Portfolio API"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:REPLACE_WITH_YOUR_EXISTING_APP_KEY
APP_URL=https://YOUR-BACKEND.onrender.com
FRONTEND_URL=https://YOUR-FRONTEND.vercel.app
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Supabase Connect > Session pooler. Copy the exact host and username shown there.
DB_CONNECTION=pgsql
DB_HOST=YOUR-SESSION-POOLER-HOST.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
DB_SSLMODE=require

# Persistent admin sessions; public content caching stays local for speed.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none
SESSION_DOMAIN=null
CACHE_STORE=file
PUBLIC_CONTENT_CACHE_SECONDS=60
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# Copy the working bucket values privately from backend/.env.
FILESYSTEM_DISK=s3
MEDIA_DISK=s3
MEDIA_SIGNED_URLS=true
AWS_ACCESS_KEY_ID=REPLACE_WITH_BUCKET_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_BUCKET_SECRET
AWS_DEFAULT_REGION=REPLACE_WITH_BUCKET_REGION
AWS_BUCKET=REPLACE_WITH_BUCKET_NAME
AWS_ENDPOINT=https://REPLACE_WITH_S3_ENDPOINT
AWS_USE_PATH_STYLE_ENDPOINT=false

# Database already migrated. Enable only for reviewed pending migrations.
RUN_MIGRATIONS=false
